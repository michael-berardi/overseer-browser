{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["chrome"],
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [".wxt/types/**/*.d.ts", "entrypoints", "src", "wxt.config.ts"]
}
