{
  "name": "@imploselabs/overseer-browser-extension",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "check": "tsc --noEmit",
    "dev": "wxt",
    "test": "vitest run",
    "release:verify": "python3 ../scripts/test_publish_chrome_web_store.py && python3 ../scripts/verify_release.py .output/chrome-mv3",
    "release:package": "python3 ../scripts/publish_chrome_web_store.py --artifact .output/chrome-mv3",
    "release:publish": "python3 ../scripts/publish_chrome_web_store.py --artifact .output/chrome-mv3 --publish"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wxt": "^0.21.4"
  }
}
